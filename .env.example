# PR Radar configuration.
# A variable already exported in your shell takes precedence over this file.

# GitHub org to scan. Required.
PR_RADAR_ORG=your-org

# Local server port.
PORT=4321

# A PR with no real activity for more than N days is ignored.
# "Real activity" = last commit, human comment or review.
PR_RADAR_MAX_AGE_DAYS=60

# Auto-refresh interval, in seconds.
# Also used as the server-side cache duration; the Refresh button bypasses it.
PR_RADAR_REFRESH_SECONDS=300

# Link to gitdeck (a local web git client) shown in the header.
# Empty by default so the button stays hidden for anyone who does not run gitdeck — an
# unset variable falls back to the localhost URL below instead, showing a dead button.
# Fill it in only if you actually run gitdeck alongside this.
PR_RADAR_GITDECK_URL=

# Keep draft PRs off the board.
PR_RADAR_HIDE_DRAFTS=false

# Time of day the daily notes are pre-warmed on weekday mornings, HH:MM, 24h.
# Only read by daily-notes-install.sh at install time — the schedule itself lives in the
# generated launchd job, not read from here at run time. See README's "Automatic notes".
PR_RADAR_DAILY_NOTES_TIME=08:30
