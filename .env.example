# PR Radar configuration.
# A variable already exported in your shell takes precedence over this file.

# GitHub org to scan. Required.
PR_RADAR_ORG=your-org

# Local server port.
PORT=4321

# A PR with no real activity for more than N days is ignored.
# "Real activity" = last commit, human comment or review.
PR_RADAR_MAX_AGE_DAYS=60

# How long a merge of yours stays watched, in hours.
# A rolling window from the merge time, not a calendar day: a merge at 23:50 would
# otherwise stay visible for ten minutes.
PR_RADAR_MERGED_HOURS=12

# Auto-refresh interval, in seconds.
# Also used as the server-side cache duration; the Refresh button bypasses it.
PR_RADAR_REFRESH_SECONDS=300

# Link to gitdeck (a local web git client) shown in the header.
# Leave the value empty to hide the link.
PR_RADAR_GITDECK_URL=http://localhost:4567

# Keep draft PRs off the board.
PR_RADAR_HIDE_DRAFTS=false
