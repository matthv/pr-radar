# Configuration de PR Radar.
# Une variable déjà exportée dans ton shell a priorité sur ce fichier.

# Org GitHub scannée.
PR_RADAR_ORG=ForestAdmin

# Port du serveur local.
PORT=4321

# Une PR sans activité réelle depuis plus de N jours est ignorée.
# « Activité réelle » = dernier commit, commentaire humain ou review.
PR_RADAR_MAX_AGE_DAYS=60

# Intervalle du rafraîchissement automatique, en secondes.
# Sert aussi de durée de cache côté serveur : le bouton Rafraîchir le contourne.
PR_RADAR_REFRESH_SECONDS=300
