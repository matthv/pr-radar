# PR Radar configuration.
# A variable already exported in your shell takes precedence over this file.

# GitHub org to scan. Required.
PR_RADAR_ORG=your-org

# Local server port.
PORT=4321

# A PR with no real activity for more than N days is ignored.
# "Real activity" = last commit, human comment or review.
PR_RADAR_MAX_AGE_DAYS=60

# Auto-refresh interval, in seconds.
# Also used as the server-side cache duration; the Refresh button bypasses it.
PR_RADAR_REFRESH_SECONDS=300

# Link to gitdeck (a local web git client) shown in the header.
# Empty by default so the button stays hidden for anyone who does not run gitdeck — an
# unset variable falls back to the localhost URL below instead, showing a dead button.
# Fill it in only if you actually run gitdeck alongside this.
PR_RADAR_GITDECK_URL=

# Your Linear workspace, without a trailing slash: a ticket key found in a PR's title or
# branch (PRD-812) gets a link on its card, beside Slack's, opening <this URL>/issue/PRD-812.
# Empty, no link.
PR_RADAR_LINEAR_URL=https://linear.app/forestadmin

# A button beside the Linear one that resumes, in a terminal, the Claude Code session in
# which the PR was created or opened. Off unless true. TERMINAL is Terminal, iTerm or Ghostty.
PR_RADAR_CLAUDE_SESSIONS=false
PR_RADAR_TERMINAL=Terminal

# Keep draft PRs off the board.
PR_RADAR_HIDE_DRAFTS=false

# Your own notification sound instead of the built-in chime: a local audio file (mp3, wav,
# ogg, m4a…), played in full when a new PR lands on your plate. `~` is your home folder.
# Empty keeps the chime. The mute button still silences it.
PR_RADAR_SOUND=

# The Slack channel where the team announces its PRs (#tech-pr). A card whose PR was
# announced there grows a button to that message. See README's "The Slack announcement
# link". Empty the channel to turn the feature off.
PR_RADAR_SLACK_CHANNEL=C0C4S34GD7H
# Optional. With no token, the channel is read through `claude -p` and your own Slack
# connector, only when a PR on the board has no link yet. A bot token (a Slack app with
# the single `channels:history` scope, invited into the channel) reads it directly instead.
PR_RADAR_SLACK_TOKEN=
# Only used to build the message links on the Claude path.
PR_RADAR_SLACK_WORKSPACE=https://forestadmin.slack.com/

# How often the server checks origin/main for newer commits, in hours, and tells you on
# the page when your clone is behind. 0 turns it off. It never pulls on its own.
PR_RADAR_UPDATE_HOURS=2

# Window in which the daily notes get re-warmed on weekday mornings, HH:MM, 24h, and how
# often within it. A single fixed time went stale by the time it was actually checked, so
# this repeats instead — every INTERVAL_MINUTES, from FROM up to (not including) UNTIL.
# FROM/UNTIL are read fresh by daily-notes.js on every run, so narrowing or widening the
# window needs only an edit here. INTERVAL_MINUTES is the one part baked into the launchd
# job itself (see daily-notes-install.sh) — changing it needs re-running that script.
# See README's "Warming them before you look".
PR_RADAR_DAILY_NOTES_FROM=07:30
PR_RADAR_DAILY_NOTES_UNTIL=09:30
PR_RADAR_DAILY_NOTES_INTERVAL_MINUTES=10
